PORT=3000
NODE_ENV=development

# Límite del body JSON (validar/publicar flujos, simulador). El default de express es 100kb y provoca 413.
# En el código el default es 2mb; podés subirlo en producción si el flujo sigue creciendo.
# EXPRESS_JSON_LIMIT=5mb

# Docker: montar ./whatsapp-bot/data en /app/data (ver docker-compose en la raíz del repo).
# En contenedor conviene dejar PORT=3000 alineado con el mapeo de puertos del compose.

# Fase 1 — persistencia de conversaciones (SQL Server). Los flujos JSON no migran a DB.
#
# Nombre de la base: tea_bot (variable DB_NAME)
# Activar persistencia de conversaciones (si DB_* están completas, se auto-habilita en dev)
CONVERSATION_DB_ENABLED=true
#
# Conexión por variables (no hardcodear en código):
# DB_SERVER=localhost
# DB_PORT=1433
# DB_NAME=tea_bot
# DB_USER=sa
# Escrituras de prueba. No se habilitan solo por usar localhost.
# La base local existente exige el nombre exacto y la confirmación exacta:
# DB_NAME=tea-bot
# TB_SQL_TEST_CONFIRM=tea-bot
# Una base dedicada sigue siendo válida con:
# DB_NAME=tea_bot_test_local
# TB_SQL_TEST_CONFIRM=tea_bot_test
# DB_PASSWORD=TeaBot_Dev_Passw0rd!
#
# Docker Compose: DB_SERVER=sqlserver (nombre del servicio)
#
# TLS (Azure SQL u hospedaje con certificado):
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERTIFICATE=false
#
# Desarrollo local / SQL Server en Docker (sin TLS):
# DB_ENCRYPT=false
# DB_TRUST_SERVER_CERTIFICATE=true
#
# CONVERSATION_DB_STRICT=0

# Reentrada después de cerrar una atención humana.
# prompt (default): el primer texto libre ofrece continuar o empezar de nuevo.
# legacy: el cierre vuelve a dejar el cursor en welcome o collect_email.
# Requiere la migración 008_conversation_reentry.sql antes de activar prompt.
# REENTRY_POLICY=prompt

# Toma manual de una conversación atendida por el bot.
# false (default): el endpoint responde 409 y el inbox no muestra el botón.
# true: un agente autorizado puede tomar bot, cola o reentrada.
# Requiere migrations/009_conversation_status_version.sql (status_version y conversation_operation_requests).
# Las conversaciones ya tomadas siguen en assigned si se vuelve a false.
# MANUAL_TAKEOVER_ENABLED=false

# Runtime de flujos: única fuente SQL Server (valores json legacy se ignoran)
FLOW_STORAGE_MODE=db

# Herramientas dev (POST /api/dev/conversations/*). En producción deben quedar deshabilitadas.
# DEV_TOOLS_ENABLED=false

# Seed local de conversaciones (solo dev; no envía Twilio)
# ALLOW_DEV_SEED=true
# RESET_DEV_SEED=true
# npm run db:seed-conversations
# npm run db:seed-conversations -- --reset

# Agente interno para assigned_agent_id sin tabla de usuarios
# INTERNAL_AGENT_ID=00000000-0000-4000-8000-000000000001
# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=15000
# DATABASE_REQUEST_TIMEOUT_MS=30000

# Admin panel (/api/flows, /api/simulator): login con cookie HTTP-only firmada
ADMIN_USERNAME=tea-bot
# SHA-256 hex de la contraseña (no guardar la contraseña en plano). Ejemplo para "Tea2026":
ADMIN_PASSWORD_HASH=
# Secreto largo para firmar la sesión (mínimo 32 caracteres)
SESSION_SECRET=cambiar_por_un_valor_largo_aleatorio_minimo_32_chars

# Operador solo conversaciones (opcional). Acceso únicamente a /conversations y API de inbox.
# Generar hash: node -e "console.log(require('crypto').createHash('sha256').update('TU_PASSWORD').digest('hex'))"
# CONVERSATIONS_OPERATOR_USERNAME=operator
# CONVERSATIONS_OPERATOR_PASSWORD_HASH=

# Meta WhatsApp Cloud API (obligatorias en producción)
META_VERIFY_TOKEN=pon_tu_verify_token
META_ACCESS_TOKEN=pon_tu_access_token
META_PHONE_NUMBER_ID=pon_tu_phone_number_id

# URL pública del backend (webhook, enlaces).
# Para la firma es el origen https://host[:puerto], o ese origen más UN prefijo.
# El pathname de esta variable y TWILIO_PUBLIC_PATH_PREFIX no se usan juntos:
# los dos a la vez es ambiguo y log/enforce no arrancan.
# Si Nginx conserva el prefijo, esta URL es solo el origen y el prefijo queda vacío.
# No uses localhost ni el host interno del contenedor en producción.
# Ejemplo sin prefijo: https://bot.example
# Ejemplo con prefijo que Nginx elimina: https://bot.example/tea
APP_BASE_URL=http://localhost:3000

# Twilio WhatsApp (V1 usa TwiML en webhook; SDK async futuro)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Firma del inbound POST /webhooks/twilio/:flowId.
# Si la variable falta, el modo efectivo es off y el preflight queda ready=false.
# off no es una activación: el inbound sigue sin autenticar. El status igual exige firma.
# Antes de pasar a log: token, URL válida y un solo lugar para el prefijo.
# Comprobar con: node scripts/twilio-signature-preflight.js
# log con token o URL faltantes no arranca. No cae a off y no es inocuo.
# Con el preflight en logReady, log registra la firma y no corta un mismatch.
# enforce solo después de twilio_signature_valid en tráfico real. Este archivo no lo activa.
# Un valor distinto de off|log|enforce aborta el arranque.
# Rollback de enforce: volver a log y reiniciar. No apaga la idempotencia.
# TWILIO_SIGNATURE_MODE=log

# Prefijo que Nginx quita antes de Express. Vacío si no hay prefijo,
# si APP_BASE_URL ya lo incluye, o si Nginx lo conserva en la ruta.
# No definirlo junto con un pathname en APP_BASE_URL.
# TWILIO_PUBLIC_PATH_PREFIX=/tea

# CORS: con login, el navegador envía credenciales; incluí el origen exacto del frontend (CSV).
# Local: Vite suele ser :5173; Docker UI suele ser :8080.
# CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Google Sheets export configuration
# Enables exporting finalized WhatsApp bot conversations to Google Sheets.
# Keep disabled (`false`) to run without external export integration.
GOOGLE_SHEETS_ENABLED=false

# Google Sheet ID from the spreadsheet URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# Sheet tab name where rows will be appended.
# Example: Conversaciones
GOOGLE_SHEETS_TAB_NAME=Conversaciones

# Optional tab for technical/raw conversation exports.
# Leave empty to disable raw export.
GOOGLE_SHEETS_RAW_TAB_NAME=

# Service Account email from the downloaded Google Cloud JSON key.
# Example: tea-bot-sheets-writer@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Private key from the downloaded Google Cloud JSON key.
# Keep the \n sequences exactly as they appear in the JSON.
# Wrap the value in double quotes in the real .env file.
# Example:
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# Security notes:
# - Never commit the real JSON key file or the private key to the repository.
# - Share the target Google Sheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as Editor.
# - If GOOGLE_SHEETS_ENABLED=true, the app expects:
#   GOOGLE_SHEETS_SPREADSHEET_ID, GOOGLE_SHEETS_TAB_NAME,
#   GOOGLE_SERVICE_ACCOUNT_EMAIL and GOOGLE_PRIVATE_KEY.

# Abandonment tracking (optional)
# Marks inactive conversations as abandoned and exports them.
ABANDON_TRACKING_ENABLED=false
ABANDON_TIMEOUT_MINUTES=30
ABANDON_SWEEP_INTERVAL_SECONDS=300
# Include simulator sessions in abandonment exports.
ABANDON_INCLUDE_SIMULATOR=false

# Conversation retention (SQL Server). Deletes conversations whose lastMessageAt
# is strictly older than CONVERSATION_RETENTION_DAYS. Dependents cascade.
# Requires CONVERSATION_DB_ENABLED=true. Default: disabled until staging validation.
# Batch size is capped at 500 (single source of truth in conversation-retention.js).
CONVERSATION_RETENTION_ENABLED=false
CONVERSATION_RETENTION_DAYS=30
CONVERSATION_RETENTION_INTERVAL_HOURS=24
CONVERSATION_RETENTION_BATCH_SIZE=100

# Export "info provided" intermediate events (non-terminal nodes).
# Keep false to log only final outcomes and avoid duplicate rows.
CONVERSATION_EXPORT_INFO_PROVIDED_EVENTS=false

# Operational monitoring. A missing variable stays off (no Twilio balance calls).
# It does not gate inbound idempotency. provider_webhook_events is always the
# authority for a Twilio MessageSid, including when this flag is false.
# Values below are the recommended settings after migration 007 is applied.
# Migration 010 stores the TwiML used to replay a retry. Idempotency works
# without it; the replay then comes back empty.
# Intervals are clamped to a minimum of 5 minutes.
MONITORING_ENABLED=true
MONITORING_TWILIO_ENABLED=true
MONITORING_TWILIO_INTERVAL_MINUTES=10
MONITORING_RECONCILIATION_INTERVAL_MINUTES=15
TWILIO_BALANCE_WARNING_USD=20
TWILIO_BALANCE_CRITICAL_USD=10
TWILIO_BALANCE_EMERGENCY_USD=5
INBOUND_ANOMALY_ENABLED=true
INBOUND_ANOMALY_WINDOW_MINUTES=30
INBOUND_ANOMALY_MIN_EXPECTED=5
TWILIO_RECONCILIATION_ENABLED=true
TWILIO_RECONCILIATION_LOOKBACK_MINUTES=60
WEBHOOK_MAX_PROCESSING_ATTEMPTS=3
# Reclaim a PROCESSING webhook after this many seconds without an ownership update.
# Clock is provider_webhook_events.updated_at, not received_at.
WEBHOOK_PROCESSING_STALE_SECONDS=120
MONITORING_ALERTS_ENABLED=true
MONITORING_ALERT_COOLDOWN_MINUTES=60

# Conversation classification (Google Sheets Consulta principal)
# Etapa A dev/staging: shadow (export legacy + comparación v2 en logs/DB)
# Etapa B prod: enabled solo tras validar métricas de fallback
# legacy | shadow | enabled
CONVERSATION_CLASSIFICATION_MODE=shadow
CONVERSATION_CLASSIFICATION_LOGGING_ENABLED=true
CONVERSATION_CLASSIFICATION_METRICS_ENABLED=true
CONVERSATION_CLASSIFICATION_TEXT_RULES_ENABLED=false
CONVERSATION_CLASSIFICATION_SHEET_UPDATE_ENABLED=false
CONVERSATION_CLASSIFICATION_RECONCILIATION_ENABLED=true
